{
  "name": "@usersatoshi/results",
  "version": "1.0.1",
  "description": "A Result type implementation for TypeScript",
  "homepage": "https://github.com/usersatoshi/results",
  "bugs": {
    "url": "https://github.com/usersatoshi/results/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://git.usersatoshi.com/usersatoshi/results.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "prepublishOnly": "bun run build",
    "docs": "typedoc --out docs src/index.ts",
    "format": "oxfmt --write package.json tsconfig.json tsconfig.cjs.json .oxfmtrc.json .oxlintrc.json src __tests__",
    "format:check": "oxfmt --check package.json tsconfig.json tsconfig.cjs.json .oxfmtrc.json .oxlintrc.json src __tests__",
    "lint": "oxlint --deny-warnings src __tests__",
    "lint:fix": "oxlint --fix src __tests__"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typedoc": "^0.28.20"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
