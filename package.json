{
  "name": "@usersatoshi/results",
  "version": "1.0.0",
  "type": "module",
  "description": "A Result type implementation for TypeScript",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://git.usersatoshi.com/usersatoshi/results.git"
  },
  "homepage": "https://github.com/usersatoshi/results",
  "bugs": {
    "url": "https://github.com/usersatoshi/results/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
